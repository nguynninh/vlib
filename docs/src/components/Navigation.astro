---
const locale = Astro.currentLocale ?? 'vi';
const segments = Astro.url.pathname.split('/').filter(Boolean);
const currentSection = segments[0] === locale ? segments[1] : segments[0];

const labels = {
    vi: {
        sdkGame: 'SDK Game',
        interactive: 'Tài liệu Interactive',
        web: 'Tài liệu Web',
        about: 'Về chúng tôi',
    },
    en: {
        sdkGame: 'SDK Game',
        interactive: 'Interactive Docs',
        web: 'Web Docs',
        about: 'About us',
    },
    zh: {
        sdkGame: 'SDK Game',
        interactive: 'Interactive 文档',
        web: 'Web 文档',
        about: '关于我们',
    },
    ja: {
        sdkGame: 'SDK Game',
        interactive: 'Interactive ドキュメント',
        web: 'Web ドキュメント',
        about: '私たちについて',
    },
};
const t = labels[locale] ?? labels.vi;

const items = [
    { label: t.sdkGame, section: 'sdk-game', path: 'sdk-game/overview/introduction' },
    { label: t.interactive, section: 'itr', path: 'itr/getting-started/overview' },
    { label: t.about, section: 'chung-toi', path: 'chung-toi' },
];

const internalItems = [
    { label: t.web, section: 'internal', path: 'internal/web-documentation/overview/introduction' },
];

const visibleItems = currentSection === 'internal' ? internalItems : items;
---

<nav class="top-nav">
    {visibleItems.map((item) => (
        <a
            href={`/${locale}/${item.path}`}
            class:list={['nav-item', { active: currentSection === item.section }]}
        >
            {item.label}
        </a>
    ))}
</nav>

<style>
    .top-nav {
        width: 100vw;
        max-width: 100vw;
        box-sizing: border-box;

        display: flex;
        align-items: center;
        justify-content: center;
        gap: 24px;

        height: 48px;
        padding: 0 48px;

        margin-left: calc(50% - 50vw);
    }

    .nav-item {
        position: relative;
        display: flex;
        align-items: center;
        height: 100%;
        color: var(--sl-color-gray-2);
        font-size: 16px;
        font-weight: 400;
        text-decoration: none;
        white-space: nowrap;
    }

    .nav-item:hover {
        color: var(--sl-color-text-accent);
    }

    .nav-item.active {
        color: var(--sl-color-text-accent);
        font-weight: 500;
    }

    .nav-item.active::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: 4px;
        height: 2px;
        background: var(--sl-color-text-accent);
    }

    @media (max-width: 49.999rem) {
        .top-nav {
            justify-content: flex-start;
            gap: 6px;
            height: auto;
            padding: 6px 12px;
            overflow-x: auto;
            scrollbar-width: none;
        }

        .top-nav::-webkit-scrollbar {
            display: none;
        }

        .nav-item {
            flex: 0 0 auto;
            height: auto;
            padding: 4px 10px;
            border: 1px solid var(--sl-color-gray-5);
            border-radius: 999px;
            color: var(--sl-color-gray-2);
            font-size: 12.5px;
        }

        .nav-item:hover {
            color: var(--sl-color-gray-2);
        }

        .nav-item.active {
            border-color: #2563eb;
            background: #2563eb;
            color: #fff;
            font-weight: 500;
        }

        .nav-item.active::after {
            content: none;
        }
    }
</style>
